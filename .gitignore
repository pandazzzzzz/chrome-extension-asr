# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Note: lock files (package-lock.json / yarn.lock / pnpm-lock.yaml) are
# INTENTIONALLY tracked — needed for reproducible installs.

# Python (if a local Whisper/ASR backend is added later)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
# Legacy Python venv name — root-only so a source dir like src/env/ isn't dropped.
# (Modern nested venvs are covered by unanchored venv/ and .venv/ above.)
/env/

# Package manager (if added later)
.bun/
.pnpm-store/
.npmrc
.yarnrc

# Build outputs
# 仅根目录 /out/ 属于构建输出；加前导斜杠可避免误伤 docs/out/ 这类真实源码目录。
# 注：本仓库无打包步骤（README 说明 load-unpacked），故没有 dist/ 与 build/ 规则。
/out/
*.zip
*.tgz

# IDE
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
# Track .vscode/settings.json, ignore the rest
.vscode/*
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment & Secrets
.env
.env.*
!.env.example
*.key
*.secret
config.local.js
secrets.json

# Chrome extension sensitive files
*.pem
*.crx
key.pem
oauth_token.json

# API Keys & Credentials
**/api_keys.json
**/credentials.json
**/token.json
**/*_secret.json
**/*_key.json
**/service-account*.json
*.p12
*.pfx

# Docs — handoff/notes stay local (internal state, unfinished work, decisions)
# ARCHITECTURE.md remains tracked (it is the public architecture record).
docs/HANDOFF.md
docs/notes/
docs/*.local.md

# Claude Code — 运行时产物与个人配置（不共享）。
# 只列已知的运行时/本地文件，.claude/ 本身不整体忽略，
# 这样共享配置（如 .claude/settings.json、.claude/skills/）仍可 git add。
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/agent-registry.json
.claude/agent-memory-local
.claude/assistant-daemon-state.json
.claude/first-run
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# Local temp directory (track structure only, ignore contents)
# temp/** 忽略所有层级内容，再显式恢复结构文件
temp/**
!temp/**/
!temp/README.md
!temp/**/.gitkeep

# User data — root-level ONLY (leading slash).
# Without the slash these would match ANY directory of that name anywhere in the
# tree, silently dropping a real source dir (e.g. src/storage/).
/user_data/
/profile/
/storage/

# AI / ML model files (large binaries, never commit)
# 临时/本地模型放 temp/models/（已忽略）；samples/ 下豁免，可提交小体积样例
/models/
*.onnx
*.bin
*.gguf
*.safetensors
*.ckpt
*.pth
*.h5
*.tflite
*.pb
*.pt
*.npz
*.npy
*.pkl

# Audio recordings (captured audio, temp files)
# 测试样例音频放在 samples/ 目录下可被 git 跟踪；临时音频放 temp/audio/
*.wav
*.mp3
*.mp4
*.ogg
*.webm
*.m4a
*.flac
*.pcm
# 例外：只放行 samples/ 下 README 约定的样例类型（扩展名白名单）。
# 早先是 `!samples/**` + `!samples/**/*` 全量豁免 —— 那会让 samples/ 下任何文件
# 都绕过本文件的所有规则，包括 .env / api_keys.json / *.pem 等密钥规则。
# 白名单方向相反：新类型必须显式添加，密钥类文件默认仍然被忽略。
!samples/**/*.wav
!samples/**/*.mp3
!samples/**/*.mp4
!samples/**/*.ogg
!samples/**/*.webm
!samples/**/*.m4a
!samples/**/*.flac
!samples/**/*.pcm
!samples/**/*.onnx
!samples/**/*.bin
!samples/**/*.gguf
!samples/**/*.safetensors
!samples/**/*.pb
!samples/**/*.tflite

# ML framework caches
.huggingface/
huggingface/**

# Local dev server runtime data
coverage/
.nyc_output/
.eslintcache
.prettiercache

# Backup files
*.bak
*.backup
# Merge/patch 残留
*.orig
*.rej
