# Normalize line endings in the repo (repo is developed on Windows + macOS/Linux).
# .editorconfig asks for LF; this makes git enforce it on add/checkout so
# cross-platform collaborators don't produce line-ending churn diffs.

* text=auto eol=lf

# Never touch binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.m4a binary
*.ogg binary
*.flac binary
*.zip binary
*.crx binary
*.pem binary
*.p12 binary

# Model / large artifacts (should be ignored anyway, belt-and-braces)
*.onnx binary
*.bin binary
*.gguf binary
*.safetensors binary
*.tflite binary
