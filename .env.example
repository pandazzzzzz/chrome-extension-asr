# =============================================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入你自己的密钥（.env 不会被 git 提交）
# =============================================================================

# OpenAI Whisper API（语音转录云端服务）
OPENAI_API_KEY=

# Deepgram（实时语音转录服务）
DEEPGRAM_API_KEY=

# Groq Whisper（Groq 提供的高速 Whisper API）
GROQ_API_KEY=

# Google Cloud Speech-to-Text
GOOGLE_APPLICATION_CREDENTIALS=

# 本地服务地址（如自建 WhisperLive 服务）
LOCAL_WHISPER_ENDPOINT=http://localhost:9090
