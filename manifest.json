{
  "manifest_version": 3,
  "name": "ASR Demo",
  "version": "1.0.0",
  "description": "A multi-provider speech recognition Chrome extension (Manifest V3)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "messaging/messages.js",
        "content/content.js"
      ],
      "css": ["content/content.css"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://dashscope.aliyuncs.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://api.openai.com/*",
    "https://api.deepgram.com/*"
  ]
}
